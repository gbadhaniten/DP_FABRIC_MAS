# ============================================================
# Fabric-MAS Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# No OpenAI API key needed — GitHub Copilot is the LLM!

# --- Tavily (Autotrain search, optional but recommended) ---
TAVILY_API_KEY=tvly-...your-key-here...

# --- Bing Search (fallback, optional) ---
BING_SEARCH_API_KEY=

# --- Microsoft Fabric ---
FABRIC_WORKSPACE_ID=your-default-workspace-guid
FABRIC_DRY_RUN=true
